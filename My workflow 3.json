    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Pega o texto enviado no campo de mensagem/solicitação do formulário\n  const mensagem = (item.json.mensagem || item.json.solicitacao || \"\").toLowerCase();\n  \n  let categoria = \"Dúvida Geral\";\n  \n  // Regra simples de categorização baseada em palavras-chave\n  if (mensagem.includes(\"erro\") || mensagem.includes(\"problema\") || mensagem.includes(\"falha\") || mensagem.includes(\"ajuda\")) {\n    categoria = \"Suporte Técnico\";\n  } else if (mensagem.includes(\"comprar\") || mensagem.includes(\"preço\") || mensagem.includes(\"plano\") || mensagem.includes(\"valor\")) {\n    categoria = \"Comercial / Vendas\";\n  }\n  \n  // Adiciona a nova propriedade com a categoria tratada\n  item.json.categoria = categoria;\n  item.json.data_registro = new Date().toISOString();\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
